{
  "title": "NNUE evaluator hardware architecture (current RTL)",
  "groups": [
    {"id": "update", "label": "Incremental accumulator update path"},
    {"id": "state", "label": "Per-thread live state"},
    {"id": "eval", "label": "Four-cycle output evaluation path"}
  ],
  "blocks": [
    {"id": "update_req", "label": "Update request", "subtitle": "thread, features, add/remove, clear", "kind": "io", "group": "update", "at": [0, 1]},
    {"id": "feature_rom", "label": "Feature transformer ROM", "subtitle": "768 rows × 256 signed 2-bit weights", "kind": "memory", "group": "update", "at": [1, 1]},
    {"id": "acc_bias", "label": "Accumulator bias", "subtitle": "256 × signed 3-bit", "kind": "memory", "group": "update", "at": [1, 0]},
    {"id": "update_ctrl", "label": "Update control", "subtitle": "one row accepted per cycle", "kind": "fsm", "group": "update", "at": [2, 0]},
    {"id": "lane_update", "label": "512-lane accumulator add/sub", "subtitle": "two perspectives × 256 signed 5-bit lanes", "kind": "addsub", "group": "update", "bigger": true, "at": [2, 1]},
    {"id": "update_done", "label": "Update completion", "subtitle": "thread + ply tag", "kind": "io", "group": "update", "at": [3, 0]},

    {"id": "update_state", "label": "Update-state memory", "subtitle": "one 2 × 256 × 5-bit word per thread", "kind": "memory", "group": "state", "bigger": true, "at": [3, 1]},
    {"id": "eval_mirror", "label": "Evaluation mirror", "subtitle": "multi-thread independent read port", "kind": "memory", "group": "state", "at": [3, 2]},

    {"id": "eval_req", "label": "Evaluation request", "subtitle": "thread, turn, piece count", "kind": "io", "group": "eval", "at": [0, 4]},
    {"id": "bucket", "label": "16-head bucket select", "subtitle": "two-piece phase bands", "kind": "logic", "group": "eval", "at": [1, 3]},
    {"id": "snapshot", "label": "Accumulator snapshot", "subtitle": "512 signed 5-bit values", "kind": "reg", "group": "eval", "at": [4, 4]},
    {"id": "reorder_clip", "label": "Perspective reorder\n+ ReLU clip", "subtitle": "side to move first; clamp to 0…7", "kind": "logic", "group": "eval", "at": [5, 4]},
    {"id": "weight_rows", "label": "Output-weight rows", "subtitle": "16 heads × 4 rows × 128 signed 3-bit", "kind": "memory", "group": "eval", "at": [5, 3]},
    {"id": "eval_ctrl", "label": "Evaluation sequencer", "subtitle": "four MAC cycles", "kind": "fsm", "group": "eval", "at": [6, 3]},
    {"id": "mac", "label": "128 parallel multipliers", "subtitle": "generic inferred LUT/DSP mapping", "kind": "multiplier", "group": "eval", "bigger": true, "at": [6, 4]},
    {"id": "partials", "label": "16 registered partial sums", "subtitle": "eight products per register", "kind": "reg", "group": "eval", "at": [7, 4]},
    {"id": "out_bias", "label": "Output biases", "subtitle": "16 × signed 5-bit", "kind": "memory", "group": "eval", "at": [7, 3]},
    {"id": "sum_tree", "label": "Upper adder tree\n+ running sum", "subtitle": "accumulates four 128-input groups", "kind": "adder", "group": "eval", "at": [8, 4]},
    {"id": "result_reg", "label": "Result register", "subtitle": "signed 15-bit sum", "kind": "reg", "group": "eval", "at": [9, 4]},
    {"id": "score_clip", "label": "Finite-score clip", "subtitle": "±16,383", "kind": "logic", "group": "eval", "at": [10, 4]},
    {"id": "result", "label": "NNUE correction", "subtitle": "side-to-move relative", "kind": "io", "group": "eval", "at": [11, 4]}
  ],
  "edges": [
    {"from": "update_req.features", "to": "feature_rom.address", "label": "White + Black feature indices", "width": 20},
    {"from": "update_req.control", "to": "update_ctrl.request", "kind": "control"},
    {"from": "feature_rom.rows", "to": "lane_update.weights", "label": "two transformer rows", "width": 1024},
    {"from": "acc_bias.bias", "to": "lane_update.init", "width": 768},
    {"from": "update_ctrl.control", "to": "lane_update.control", "label": "enable / add / clear", "kind": "control"},
    {"from": "update_state.old", "to": "lane_update.old", "width": 2560, "kind": "response", "via": "bottom"},
    {"from": "lane_update.new", "to": "update_state.write", "width": 2560},
    {"from": "lane_update.mirror", "to": "eval_mirror.write", "label": "mirrored commit", "width": 2560},
    {"from": "update_ctrl.complete", "to": "update_done.tag", "label": "final-request tag", "kind": "response"},

    {"from": "eval_req.phase", "to": "bucket.count", "label": "piece count", "width": 6},
    {"from": "eval_req.start", "to": "eval_ctrl.start", "kind": "control"},
    {"from": "eval_req.select", "to": "snapshot.select", "label": "thread + turn", "kind": "control"},
    {"from": "bucket.head", "to": "weight_rows.select", "label": "head select", "width": 4, "kind": "control"},
    {"from": "bucket.head", "to": "out_bias.select", "width": 4, "kind": "control"},
    {"from": "eval_mirror.read", "to": "snapshot.multi", "label": "multi-thread synchronous read", "width": 2560},
    {"from": "update_state.read", "to": "snapshot.single", "label": "single-thread direct snapshot", "width": 2560},
    {"from": "snapshot.values", "to": "reorder_clip.values", "width": 2560},
    {"from": "reorder_clip.activations", "to": "mac.activations", "label": "128 activations per cycle", "width": 512},
    {"from": "weight_rows.weights", "to": "mac.weights", "label": "selected weight row", "width": 384},
    {"from": "eval_ctrl.cycle", "to": "weight_rows.row", "label": "row 0…3", "kind": "control"},
    {"from": "eval_ctrl.phase", "to": "mac.control", "kind": "control"},
    {"from": "mac.products", "to": "partials.products", "width": 768},
    {"from": "partials.groups", "to": "sum_tree.groups", "label": "16 partial sums", "width": 144},
    {"from": "out_bias.bias", "to": "sum_tree.initial", "width": 5},
    {"from": "eval_ctrl.accumulate", "to": "sum_tree.control", "kind": "control"},
    {"from": "sum_tree.sum", "to": "result_reg.sum", "label": "completed sum", "width": 15},
    {"from": "result_reg.sum", "to": "score_clip.sum", "width": 15},
    {"from": "score_clip.score", "to": "result.score", "label": "result valid + score", "width": 16}
  ]
}
